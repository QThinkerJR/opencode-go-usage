{
  "name": "@qthinker/opencode-go-usage",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin that shows OpenCode Go subscription usage (5-hour, weekly, monthly) in the TUI sidebar and Desktop side panel.",
  "type": "module",
  "license": "MIT",
  "author": "QThinker",
  "homepage": "https://github.com/QThinkerJR/opencode-go-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QThinkerJR/opencode-go-usage.git"
  },
  "bugs": {
    "url": "https://github.com/QThinkerJR/opencode-go-usage/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "usage",
    "quota",
    "limits",
    "tui",
    "desktop",
    "sidebar"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui/index.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:gui": "vite build",
    "prepublishOnly": "bun run typecheck && bun test && bun run build:gui"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.7",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.1",
    "@opencode/theme": "2.4.1",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/bun": "^1.4.3",
    "solid-js": "^1.9.0",
    "typescript": "^7",
    "vite": "^7",
    "vite-plugin-solid": "^2.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
